# Reliquary shared-protocol R2 backend — env contract.
#
# Copy to .env.local (gitignored) and fill in real values for local dev
# or CI. Consumers: reliquary, reliquary-inference, reliquary-web.

# Cloudflare R2 account + bucket
RELIQUARY_R2_ACCOUNT_ID=
RELIQUARY_R2_BUCKET=reliquary

# Cloudflare API token with R2 object read/write permission on the bucket.
# Create one at https://dash.cloudflare.com/profile/api-tokens with scope:
#   R2 Object Read, R2 Object Write — scoped to the single bucket.
RELIQUARY_R2_CF_API_TOKEN=

# Optional r2.dev public URL — when set, GET requests try this first
# (CDN-cached, no auth) and fall back to the authenticated API on miss.
RELIQUARY_R2_PUBLIC_URL=
